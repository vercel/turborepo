$ cd color && stringer -type=Color,Shade
# stringer [stringer] Full
{
  "outputs": [
    {
      "path": "color/color_string.go",
      "kind": "generated"
    }
  ],
  "configs": [
    "go.mod",
    "go.sum"
  ],
  "entries": [
    {
      "path": "color",
      "lang": "go"
    }
  ],
  "memberships": [
    {
      "dir": "color",
      "pattern": "*.go",
      "exclude": [
        "color_string.go"
      ],
      "reason": "go package"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "go",
      "name": "golang.org/x/tools/cmd/stringer"
    }
  ]
}

