---
source: crates/turborepo-trace-tasks/tests/codegen.rs
expression: family(stringify! (graphql))
---
$ graphql-codegen
# graphql-codegen [graphql-codegen] Full
{
  "inputs": [
    "scalars.graphql",
    "schema.graphql"
  ],
  "outputs": [
    {
      "path": "src/gql",
      "kind": "generated"
    },
    {
      "path": "src/types.ts",
      "kind": "generated"
    }
  ],
  "configs": [
    "codegen.ts"
  ],
  "entries": [
    {
      "path": "codegen.ts",
      "lang": "js"
    }
  ],
  "memberships": [
    {
      "dir": "src",
      "pattern": "**/*.graphql",
      "exclude": [
        "legacy/**"
      ],
      "reason": "graphql documents"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/cli"
    },
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/preset-client"
    },
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/typescript"
    },
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/typescript-operations"
    }
  ]
}

$ graphql-codegen --config codegen.alt.yml
# graphql-codegen [graphql-codegen] Partial
{
  "inputs": [
    "src/types.ts"
  ],
  "outputs": [
    {
      "path": "src",
      "pattern": "**/*.generated.tsx",
      "kind": "generated"
    },
    {
      "path": "src/types.ts",
      "kind": "generated"
    }
  ],
  "configs": [
    "codegen.alt.yml"
  ],
  "memberships": [
    {
      "dir": ".",
      "pattern": "**",
      "reason": "`graphql-codegen` not fully recognized"
    },
    {
      "dir": ".",
      "pattern": "**",
      "reason": "code generator config not fully known"
    },
    {
      "dir": "extra",
      "pattern": "*.graphql",
      "reason": "graphql schema"
    },
    {
      "dir": "src",
      "pattern": "**/*.tsx",
      "reason": "graphql documents"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/cli"
    },
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/preset-near-operation-file"
    },
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/typescript"
    },
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/typescript-operations"
    },
    {
      "ecosystem": "npm",
      "name": "@graphql-codegen/typescript-react-apollo"
    }
  ],
  "uncertainties": [
    {
      "kind": "env_dependent",
      "detail": "remote graphql schema `http://localhost:4000/graphql`"
    }
  ]
}

