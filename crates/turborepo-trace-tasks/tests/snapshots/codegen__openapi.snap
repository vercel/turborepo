      "path": "src/remote.ts",
      "kind": "generated"
    }
  ],
  "memberships": [
    {
      "dir": ".",
      "pattern": "**",
      "reason": "`openapi-typescript` not fully recognized"
    },
    {
      "dir": ".",
      "pattern": "**",
      "reason": "code generator config not fully known"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "openapi-typescript"
    }
  ],
  "uncertainties": [
    {
      "kind": "env_dependent",
      "detail": "remote spec `https://example.com/openapi.json`"
    }
  ]
}

$ openapi-generator-cli generate -i openapi.yaml -g typescript-axios -o src/gen/axios -t templates
# openapi-generator-cli [openapi-generator] Full
{
  "inputs": [
    "openapi.yaml",
    "schemas/common.yaml",
    "schemas/pet.yaml",
    "src/gen/axios/.openapi-generator-ignore"
  ],
  "outputs": [
    {
      "path": "src/gen/axios",
      "kind": "generated"
    }
  ],
  "configs": [
    "openapitools.json"
  ],
  "memberships": [
    {
      "dir": "templates",
      "pattern": "**",
      "reason": "openapi-generator templates"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "@openapitools/openapi-generator-cli"
    }
  ]
}

