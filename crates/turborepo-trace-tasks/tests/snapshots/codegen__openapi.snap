  "inputs": [
    "openapi.yaml",
    "schemas/common.yaml",
    "schemas/pet.yaml"
  ],
  "outputs": [
    {
      "path": "src/api/schema.d.ts",
      "kind": "generated"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "openapi-typescript"
    }
  ]
}

