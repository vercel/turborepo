$ orval
# orval [orval] Full
{
  "inputs": [
    "openapi.yaml",
    "schemas/common.yaml",
    "schemas/pet.yaml"
  ],
  "outputs": [
    {
      "path": "src",
      "pattern": "simple.*",
      "kind": "generated"
    },
    {
      "path": "src/orval",
      "kind": "generated"
    },
    {
      "path": "src/orval/model",
      "kind": "generated"
    },
    {
      "path": "src/simple.ts",
      "kind": "generated"
    }
  ],
  "configs": [
    "orval.config.ts"
  ],
  "entries": [
    {
      "path": "orval.config.ts",
      "lang": "js"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "orval"
    }
  ]
}

