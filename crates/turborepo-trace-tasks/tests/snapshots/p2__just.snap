## just:.:release
{
  "sources": [
    "just"
  ],
  "files": [
    "justfile",
    "tasks/common.just"
  ],
  "deps": [
    "just:.:build"
  ],
  "commands": [
    "echo releasing ${just_param_tag} ${__JUST_UNKNOWN} [noop] Ignored",
    "./scripts/publish.sh ${just_param_tag} [shell-script] Partial"
  ],
