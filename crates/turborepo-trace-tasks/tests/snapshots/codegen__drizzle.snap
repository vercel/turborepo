---
source: crates/turborepo-trace-tasks/tests/codegen.rs
expression: family(stringify! (drizzle))
---
$ drizzle-kit generate
# drizzle-kit [drizzle-kit] Full
{
  "outputs": [
    {
      "path": "drizzle",
      "kind": "generated"
    }
  ],
  "configs": [
    "drizzle.config.ts"
  ],
  "entries": [
    {
      "path": "drizzle.config.ts",
      "lang": "js"
    },
    {
      "path": "src/db/schema/users.ts",
      "lang": "js"
    }
  ],
  "memberships": [
    {
      "dir": "drizzle/meta",
      "pattern": "**",
      "reason": "drizzle snapshots"
    },
    {
      "dir": "src/db/schema",
      "pattern": "*.ts",
      "reason": "drizzle schema"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "drizzle-kit"
    }
  ]
}

