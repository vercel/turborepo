---
source: crates/turborepo-trace-tasks/tests/codegen.rs
expression: family(stringify! (prisma))
---
$ prisma generate
# prisma [prisma] Full
{
  "inputs": [
    "prisma/schema.prisma"
  ],
  "outputs": [
    {
      "path": "src/zod",
      "kind": "generated"
    }
  ],
  "output_packages": [
    {
      "ecosystem": "npm",
      "name": ".prisma/client"
    },
    {
      "ecosystem": "npm",
      "name": "@prisma/client"
    }
  ],
  "configs": [
    "package.json",
    "prisma.config.ts"
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "@prisma/client"
    },
    {
      "ecosystem": "npm",
      "name": "prisma"
    },
    {
      "ecosystem": "npm",
      "name": "zod-prisma-types"
    }
  ]
}

$ prisma migrate dev --name init
# prisma [prisma] Full
{
  "inputs": [
    "prisma/schema.prisma"
  ],
  "outputs": [
    {
      "path": "prisma/migrations",
      "kind": "generated"
    },
    {
      "path": "src/zod",
      "kind": "generated"
    }
  ],
  "output_packages": [
    {
      "ecosystem": "npm",
      "name": ".prisma/client"
    },
    {
      "ecosystem": "npm",
      "name": "@prisma/client"
    }
  ],
  "configs": [
    "package.json",
    "prisma.config.ts"
  ],
  "entries": [
    {
      "path": "prisma/seed.ts",
      "lang": "js"
    }
  ],
  "memberships": [
    {
      "dir": "prisma/migrations",
      "pattern": "**",
      "reason": "prisma migrations"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "@prisma/client"
    },
    {
      "ecosystem": "npm",
      "name": "prisma"
    },
    {
      "ecosystem": "npm",
      "name": "tsx"
    },
    {
      "ecosystem": "npm",
      "name": "zod-prisma-types"
    }
  ],
  "env": [
    "DATABASE_URL"
  ],
  "definition": [
    "prisma/seed.ts"
  ]
}

