      "path": "envcfg/prisma.config.ts",
      "lang": "js"
    }
  ],
  "memberships": [
    {
      "dir": ".",
      "pattern": "**",
      "reason": "`prisma` not fully recognized"
    },
    {
      "dir": "envcfg",
      "pattern": "**",
      "reason": "code generator config not fully known"
    },
    {
      "dir": "envcfg/prisma/schema",
      "pattern": "**/*.prisma",
      "reason": "prisma schema folder"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "@prisma/client"
    },
    {
      "ecosystem": "npm",
      "name": "prisma"
    }
  ],
  "uncertainties": [
    {
      "kind": "env_dependent",
      "detail": "prisma.config `schema`: process.env.PRISMA_SCHEMA"
    }
  ]
}

