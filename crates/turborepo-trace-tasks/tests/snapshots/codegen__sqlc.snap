---
source: crates/turborepo-trace-tasks/tests/codegen.rs
expression: family(stringify! (sqlc))
---
$ sqlc generate
# sqlc [sqlc] Full
{
  "inputs": [
    "db/queries/users.sql",
    "db/schema.sql"
  ],
  "outputs": [
    {
      "path": "gen/py",
      "kind": "generated"
    },
    {
      "path": "internal/db",
      "pattern": "{db.go,models.go,querier.go,copyfrom.go,batch.go,*.sql.go}",
      "kind": "generated"
    }
  ],
  "configs": [
    "sqlc.yaml"
  ],
  "memberships": [
    {
      "dir": "db/migrations",
      "pattern": "*.sql",
      "reason": "sqlc sql"
    },
    {
      "dir": "db/queries",
      "pattern": "*.sql",
      "reason": "sqlc sql"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "go",
      "name": "github.com/sqlc-dev/sqlc/cmd/sqlc"
    },
    {
      "ecosystem": "sqlc",
      "name": "https://downloads.sqlc.dev/plugin/sqlc-gen-python_1.2.0.wasm"
    }
  ]
}

