$ tsc -p tsconfig.build.json
# tsc [tsc] Full
{
  "outputs": [
    {
      "path": "dist",
      "kind": "artifact"
    },
    {
      "path": "types",
      "pattern": "**/*.d.*ts",
      "kind": "artifact"
    },
    {
      "path": "types",
      "pattern": "**/*.d.*ts.map",
      "kind": "artifact"
    }
  ],
  "configs": [
    "node_modules/@tsconfig/node20/tsconfig.json",
    "tsconfig.base.json",
    "tsconfig.build.json",
    "tsconfig.json"
  ],
  "memberships": [
    {
      "dir": "src",
      "pattern": "**/*.ts",
      "exclude": [
        "**/*.fixture.ts"
      ],
      "reason": "tsconfig include"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "@tsconfig/node20"
    },
    {
      "ecosystem": "npm",
      "name": "typescript"
    }
  ]
}

