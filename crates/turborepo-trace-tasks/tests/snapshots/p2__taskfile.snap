## taskfile:.:gen
{
  "sources": [
    "taskfile"
  ],
  "files": [
    "Taskfile.yml"
  ],
  "deps": [],
  "commands": [
    "node scripts/gen.js schema/api.json > src/generated/client.js [node] Full"
  ],
  "spec": {
    "inputs": [
      ".env",
      "schema/api.json",
      "scripts/gen.js"
    ],
    "outputs": [
      {
        "path": "src/generated/client.js",
        "kind": "generated"
      }
    ],
    "configs": [
      "Taskfile.yml"
    ],
    "entries": [
      {
        "path": "scripts/gen.js",
        "lang": "js"
      }
    ],
    "memberships": [
      {
        "dir": "schema",
        "pattern": "*.json",
        "exclude": [
          "draft.json"
        ],
        "reason": "taskfile sources"
      }
    ],
    "definition": [
      "scripts/gen.js"
    ]
  }
}

