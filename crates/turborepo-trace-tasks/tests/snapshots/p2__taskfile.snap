---
source: crates/turborepo-trace-tasks/tests/p2.rs
expression: "render(&set, &root, &[\"taskfile\"])"
---
## taskfile:.:build
{
  "sources": [
    "taskfile"
  ],
  "files": [
    "Taskfile.yml"
  ],
  "deps": [
    "taskfile:.:gen",
    "taskfile:.:lib:compile"
  ],
  "commands": [
    "tsc -p tsconfig.json --outDir dist [tsc] Full",
    "echo ${__TASKFILE_UNKNOWN} [noop] Ignored"
  ],
  "spec": {
    "inputs": [
      ".env"
    ],
    "outputs": [
      {
        "path": "dist",
        "kind": "artifact"
      },
      {
        "path": "dist",
        "pattern": "**",
        "kind": "declared"
      }
    ],
    "configs": [
      "Taskfile.yml",
      "tsconfig.json"
    ],
    "memberships": [
      {
        "dir": ".",
        "pattern": "**",
        "reason": "uncertain task"
      },
      {
        "dir": ".",
        "pattern": "**",
        "reason": "unsupported shell syntax"
      },
      {
        "dir": "src",
        "pattern": "**/*.ts",
        "reason": "taskfile sources"
      },
      {
        "dir": "src",
        "pattern": "**/*.ts",
        "reason": "tsconfig include"
      }
    ],
    "task_deps": [
      {
        "target": {
          "kind": "id",
          "id": "taskfile:.:gen"
        },
        "reason": "taskfile deps"
      },
      {
        "target": {
          "kind": "id",
          "id": "taskfile:.:lib:compile"
        },
        "reason": "taskfile task call"
      }
    ],
    "toolchain": [
      {
        "ecosystem": "npm",
        "name": "typescript"
      }
    ],
    "uncertainties": [
      {
        "kind": "shell_unsupported",
        "detail": "unknown variable `${__TASKFILE_UNKNOWN}`"
      }
    ]
  }
}

