---
source: crates/turborepo-trace-tasks/tests/codegen.rs
expression: family(stringify! (protobuf))
---
$ buf generate
# buf [buf] Full
{
  "inputs": [
    "buf.lock"
  ],
  "outputs": [
    {
      "path": "gen/custom",
      "kind": "generated"
    },
    {
      "path": "gen/go",
      "pattern": "**/*.pb.go",
      "kind": "generated"
    },
    {
      "path": "gen/ts",
      "kind": "generated"
    }
  ],
  "configs": [
    "buf.gen.yaml",
    "buf.yaml"
  ],
  "memberships": [
    {
      "dir": "proto",
      "pattern": "**/*.proto",
      "exclude": [
        "internal/**"
      ],
      "reason": "buf module"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "buf",
      "name": "buf.build/connectrpc/es"
    },
    {
      "ecosystem": "system",
      "name": "buf"
    },
    {
      "ecosystem": "system",
      "name": "protoc-gen-custom"
    },
    {
      "ecosystem": "system",
      "name": "protoc-gen-go"
    }
  ]
}

