## gha:.github/workflows/ci.yml#build
{
  "sources": [
    "gha"
  ],
  "files": [
    ".github/workflows/ci.yml"
  ],
  "deps": [
    "task:.#build",
    "gha:.github/workflows/ci.yml#setup"
  ],
  "commands": [
    "pnpm turbo run build [turbo] Full",
    "node scripts/check.js [node] Full"
  ],
  "spec": {
