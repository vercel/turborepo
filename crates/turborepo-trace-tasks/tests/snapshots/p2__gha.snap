        "exclude": [
          "src/**/*.md"
        ],
        "reason": "gha paths filter"
      },
      {
        "dir": "src",
        "pattern": "**",
        "exclude": [
          "**/*.md"
        ],
        "reason": "gha paths filter"
      }
    ],
    "task_deps": [
      {
        "target": {
          "kind": "all",
          "name": "build"
        },
        "reason": "turbo run"
      },
      {
        "target": {
          "kind": "id",
          "id": "gha:.github/workflows/ci.yml#setup"
        },
        "reason": "gha needs"
      }
    ],
    "toolchain": [
      {
        "ecosystem": "gha",
        "name": "actions/cache@v4"
      },
      {
        "ecosystem": "npm",
        "name": "turbo"
      }
    ],
    "runs": [
      {
        "kind": "task",
        "target": {
          "kind": "all",
          "name": "build"
        }
      }
    ],
    "definition": [
      "tools/scripts/check.js"
    ]
  }
}

