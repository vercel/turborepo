$ FOO=bar some-unknown-tool --flag
# some-unknown-tool [-] Unknown
{
  "memberships": [
    {
      "dir": ".",
      "pattern": "**",
      "reason": "unknown command `some-unknown-tool`"
    }
  ],
  "uncertainties": [
    {
      "kind": "unknown_command",
      "detail": "some-unknown-tool"
    }
  ]
}

$ npm run lint && pnpm --filter @acme/web run build && yarn workspace web test
# npm [package-manager] Full | pnpm [package-manager] Full | yarn [package-manager] Full
{
  "task_deps": [
    {
      "target": {
        "kind": "local",
        "name": "lint"
      },
      "reason": "npm run"
    },
    {
      "target": {
        "kind": "package",
        "package": "@acme/web",
        "name": "build"
      },
      "reason": "pnpm run"
    },
    {
      "target": {
        "kind": "package",
        "package": "web",
        "name": "test"
      },
      "reason": "yarn run"
    }
  ],
  "runs": [
    {
      "kind": "task",
      "target": {
        "kind": "local",
        "name": "lint"
      }
    },
    {
      "kind": "task",
      "target": {
        "kind": "package",
        "package": "@acme/web",
        "name": "build"
      }
    },
    {
      "kind": "task",
      "target": {
        "kind": "package",
        "package": "web",
        "name": "test"
      }
    }
  ]
}

