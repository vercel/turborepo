---
source: crates/turborepo-trace-tasks/tests/fixtures.rs
expression: family(stringify! (fs))
---
$ cp -r assets dist/assets
# cp [cp] Full
{
  "outputs": [
    {
      "path": "dist/assets",
      "kind": "artifact"
    }
  ],
  "memberships": [
    {
      "dir": "assets",
      "pattern": "**",
      "reason": "cp source"
    }
  ]
}

$ cat header.txt src/body.txt > dist/out.txt
# cat [cat] Full
{
  "inputs": [
    "header.txt",
    "src/body.txt"
  ],
  "outputs": [
    {
      "path": "dist/out.txt",
      "kind": "artifact"
    }
  ]
}

$ rsync -av --exclude=node_modules assets/ dist/
# rsync [cp] Full
{
  "outputs": [
    {
      "path": "dist",
      "kind": "artifact"
    }
  ],
  "memberships": [
    {
      "dir": "assets",
      "pattern": "**",
      "reason": "rsync source"
    }
  ]
}

$ mkdir -p dist && rm -rf build
# mkdir [touch] Ignored | rm [noop] Ignored
{}

$ shx cp header.txt dist/
# shx [cp] Full
{
  "inputs": [
    "header.txt"
  ],
  "outputs": [
    {
      "path": "dist",
      "kind": "artifact"
    }
  ]
}

$ tar czf dist/a.tgz assets
# tar [tar] Full
{
  "outputs": [
    {
      "path": "dist/a.tgz",
      "kind": "artifact"
    }
  ],
  "memberships": [
    {
      "dir": "assets",
      "pattern": "**",
      "reason": "archived"
    }
  ]
}

$ echo done && sleep 1
# echo [noop] Ignored | sleep [noop] Ignored
{}

$ eslint src --max-warnings 0
# eslint [lint] Full
{
  "inputs": [
    "package.json"
  ],
  "configs": [
    "eslint.config.js"
  ],
  "entries": [
    {
      "path": "eslint.config.js",
      "lang": "js"
    }
  ],
  "memberships": [
    {
      "dir": "src",
      "pattern": "**",
      "reason": "eslint files",
      "data": true
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "eslint"
    }
  ]
}

