---
source: crates/turborepo-trace-tasks/tests/p2.rs
expression: "render(&set, &root, &[\"cargo\", \"task\"])"
---
## task:.#check
{
  "sources": [
    "npm"
  ],
  "files": [
    "package.json"
  ],
  "deps": [
    "cargo:.:lint"
  ],
  "commands": [
    "cargo lint [cargo-alias] Full"
  ],
  "spec": {
    "inputs": [
      ".cargo/config",
      ".cargo/config.toml",
      ".clippy.toml",
      ".rustfmt.toml",
      "clippy.toml",
      "rust-toolchain",
      "rust-toolchain.toml",
      "rustfmt.toml"
    ],
    "configs": [
      ".cargo/config.toml",
      "Cargo.lock",
      "Cargo.toml",
      "package.json"
    ],
    "memberships": [
      {
        "dir": ".",
        "pattern": "**/*.rs",
        "reason": "cargo workspace sources"
      },
      {
        "dir": ".",
        "pattern": "**/Cargo.toml",
        "reason": "cargo workspace manifests"
      },
      {
        "dir": ".",
        "pattern": "**/{build.rs,*.proto,*.c,*.h}",
        "reason": "cargo build inputs"
      }
    ],
    "task_deps": [
      {
        "target": {
          "kind": "id",
          "id": "cargo:.:lint"
        },
        "reason": "cargo alias"
      }
    ],
    "toolchain": [
      {
        "ecosystem": "system",
        "name": "cargo"
      }
    ],
    "runs": [
      {
        "kind": "task",
        "target": {
          "kind": "id",
          "id": "cargo:.:lint"
        }
      }
    ]
  }
}

## task:.#codegen
{
  "sources": [
    "npm"
  ],
  "files": [
    "package.json"
  ],
  "deps": [
    "cargo:.:xtask"
  ],
  "commands": [
    "cargo xtask codegen [cargo-alias] Full"
  ],
  "spec": {
    "inputs": [
      ".cargo/config",
      ".cargo/config.toml",
