---
source: crates/turborepo-trace-tasks/tests/fixtures.rs
expression: family(stringify! (testrunners))
---
$ jest -c jest.unit.config.js
# jest [jest] Full
{
  "inputs": [
    "jest.config.cjs",
    "jest.config.cts",
    "jest.config.js",
    "jest.config.json",
    "jest.config.mjs",
    "jest.config.mts",
    "jest.config.ts"
  ],
  "configs": [
    "jest.unit.config.js"
  ],
  "entries": [
    {
      "path": "jest.unit.config.js",
      "lang": "js"
    },
    {
      "path": "test/setup.ts",
      "lang": "js"
    }
  ],
  "memberships": [
    {
      "dir": "src",
      "pattern": "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,node}",
      "reason": "jest test files"
    },
    {
      "dir": "src",
      "pattern": "**/__mocks__/**",
      "reason": "manual mocks (jest haste map)"
    }
  ],
  "toolchain": [
    {
      "ecosystem": "npm",
      "name": "jest"
    },
    {
      "ecosystem": "npm",
      "name": "jest-environment-node"
    }
  ],
  "runs": [
    {
      "kind": "tests",
      "framework": "jest",
      "dir": "src"
    }
  ],
  "definition": [
    "jest.unit.config.js"
  ]
}

$ jest --config '{"rootDir":"."}'
