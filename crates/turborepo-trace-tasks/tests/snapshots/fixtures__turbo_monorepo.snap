          "kind": "upstream",
          "name": "build"
        },
        "reason": "turbo dependsOn ^"
      },
      {
        "target": {
          "kind": "all",
          "name": "build"
        },
        "reason": "turbo run"
      }
    ],
    "toolchain": [
