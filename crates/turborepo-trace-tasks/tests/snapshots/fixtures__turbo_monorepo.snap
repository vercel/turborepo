## task:.#test
{
  "sources": [
    "npm",
    "turbo"
  ],
  "deps": [
    "task:.#build",
    "task:packages/ui#test"
  ],
  "commands": [
    "turbo run test --filter=./packages/* [turbo] Full"
  ],
  "spec": {
    "data_inputs": [
      ".env",
      "tsconfig.base.json"
    ],
    "configs": [
      "package.json",
      "turbo.json"
    ],
    "memberships": [
      {
        "dir": ".",
        "pattern": "**",
        "exclude": [
          "README.md"
        ],
        "reason": "turbo inputs",
        "data": true
      },
      {
        "dir": "test",
        "pattern": "**",
        "reason": "turbo inputs",
        "data": true
      }
    ],
    "task_deps": [
      {
        "target": {
          "kind": "local",
          "name": "build"
        },
        "reason": "turbo dependsOn"
      },
      {
        "target": {
          "kind": "package",
          "package": "./packages/*",
          "name": "test"
        },
        "reason": "turbo run"
      }
    ],
    "toolchain": [
      {
        "ecosystem": "npm",
        "name": "turbo"
      }
    ],
    "env": [
      "CI",
      "TEST_SHARD"
    ],
    "runs": [
      {
        "kind": "task",
        "target": {
          "kind": "package",
          "package": "./packages/*",
          "name": "build"
        }
      },
      {
        "kind": "task",
        "target": {
          "kind": "package",
          "package": "./packages/*",
          "name": "codegen"
        }
      },
      {
        "kind": "task",
        "target": {
          "kind": "package",
          "package": "./packages/*",
          "name": "test"
        }
      },
      {
        "kind": "task",
        "target": {
          "kind": "all",
          "name": "build"
        }
      },
      {
        "kind": "task",
        "target": {
          "kind": "all",
          "name": "codegen"
        }
      }
    ]
  }
}

