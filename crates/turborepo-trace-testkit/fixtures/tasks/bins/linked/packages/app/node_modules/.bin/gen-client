#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
basedir_abs=$(CDPATH= cd -P -- "$basedir" && pwd -P)
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir_abs/../../../../tools/gen/bin/gen-client.js" "$@"
else
  exec node  "$basedir_abs/../../../../tools/gen/bin/gen-client.js" "$@"
fi
