      "ops": [
        {
          "op": "write",
          "path": "package-lock.json",
          "content": "{\n  \"name\": \"lockfile\",\n  \"version\": \"1.0.0\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {\n    \"\": {\n      \"name\": \"lockfile\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": {\n        \"dep-a\": \"1.0.0\",\n        \"dep-c\": \"1.0.0\",\n        \"dep-d\": \"1.0.0\"\n      }\n    },\n    \"node_modules/dep-a\": {\n      \"version\": \"1.0.0\",\n      \"resolved\": \"https://registry.npmjs.org/dep-a/-/dep-a-1.0.0.tgz\",\n      \"integrity\": \"sha512-aaaa\",\n      \"dependencies\": {\n        \"dep-b\": \"^1.0.0\"\n      }\n    },\n    \"node_modules/dep-b\": {\n      \"version\": \"1.1.0\",\n      \"resolved\": \"https://registry.npmjs.org/dep-b/-/dep-b-1.1.0.tgz\",\n      \"integrity\": \"sha512-bbbc\"\n    },\n    \"node_modules/dep-c\": {\n      \"version\": \"1.0.0\",\n      \"resolved\": \"https://registry.npmjs.org/dep-c/-/dep-c-1.0.0.tgz\",\n      \"integrity\": \"sha512-cccc\"\n    },\n    \"node_modules/dep-d\": {\n      \"version\": \"1.0.0\",\n      \"resolved\": \"https://registry.npmjs.org/dep-d/-/dep-d-1.0.0.tgz\",\n      \"integrity\": \"sha512-dddd\"\n    }\n  }\n}\n"
