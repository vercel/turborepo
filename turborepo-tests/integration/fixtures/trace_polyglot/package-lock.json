{
  "name": "trace-polyglot",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "trace-polyglot",
      "workspaces": ["apps/*", "services/*", "crates/*"]
    },
    "node_modules/ledger": {
      "resolved": "services/ledger",
      "link": true
    },
    "node_modules/rates": {
      "resolved": "crates/rates",
      "link": true
    },
    "node_modules/vitest": {
      "version": "3.2.4",
      "dev": true
    },
    "node_modules/web": {
      "resolved": "apps/web",
      "link": true
    },
    "apps/web": {
      "name": "web",
      "version": "1.0.0",
      "devDependencies": {
        "vitest": "3.2.4"
      }
    },
    "crates/rates": {
      "name": "rates",
      "version": "1.0.0"
    },
    "services/ledger": {
      "name": "ledger",
      "version": "1.0.0"
    }
  }
}
