{
  "name": "trace-jest",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "trace-jest",
      "workspaces": ["packages/*"]
    },
    "node_modules/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/jest": {
      "version": "29.7.0",
      "dev": true
    },
    "node_modules/math": {
      "resolved": "packages/math",
      "link": true
    },
    "packages/app": {
      "name": "app",
      "version": "1.0.0",
      "dependencies": {
        "math": "*"
      },
      "devDependencies": {
        "jest": "29.7.0"
      }
    },
    "packages/math": {
      "name": "math",
      "version": "1.0.0",
      "devDependencies": {
        "jest": "29.7.0"
      }
    }
  }
}
