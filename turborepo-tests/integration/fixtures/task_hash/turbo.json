{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "bundle": {
      "dependsOn": ["build"],
      "inputs": [
        {
          "mode": "dependencyOutputs",
          "from": ["build"],
          "globs": ["dist/**"]
        }
      ],
      "outputs": ["bundle/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {}
  }
}
