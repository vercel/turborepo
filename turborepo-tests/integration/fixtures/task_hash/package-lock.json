{
  "name": "task-hash",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "task-hash",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "version": "0.0.0",
      "dependencies": {
        "ui": "*"
      }
    },
    "node_modules/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/ui": {
      "version": "0.0.0"
    }
  }
}
