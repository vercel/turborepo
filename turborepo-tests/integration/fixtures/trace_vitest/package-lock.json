{
  "name": "trace-vitest",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "trace-vitest",
      "workspaces": ["packages/*"]
    },
    "node_modules/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/vitest": {
      "version": "3.2.4",
      "dev": true
    },
    "node_modules/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/core": {
      "name": "core",
      "version": "1.0.0",
      "devDependencies": {
        "vitest": "3.2.4"
      }
    },
    "packages/web": {
      "name": "web",
      "version": "1.0.0",
      "dependencies": {
        "core": "*"
      },
      "devDependencies": {
        "vitest": "3.2.4"
      }
    }
  }
}
