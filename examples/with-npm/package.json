{
  "name": "with-npm",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  },
  "packageManager": "npm@12.2.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
