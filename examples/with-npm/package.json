{
  "name": "with-npm",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.7",
    "turbo": "2.10.13"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  }
}
