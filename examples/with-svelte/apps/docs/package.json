{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@repo/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sveltejs/adapter-auto": "catalog:sveltejs",
    "@sveltejs/adapter-vercel": "catalog:sveltejs",
    "@sveltejs/kit": "catalog:sveltejs",
    "@sveltejs/vite-plugin-svelte": "catalog:sveltejs",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.15.0",
    "mdsvex": "0.12.8",
    "prettier-plugin-svelte": "catalog:sveltejs",
    "svelte": "catalog:sveltejs",
    "svelte-check": "catalog:sveltejs",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0"
  }
}
