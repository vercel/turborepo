{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check-types": "svelte-kit sync && tsc --noEmit",
    "check": "svelte-kit sync && tsc --noEmit",
    "check:watch": "svelte-kit sync && tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@repo/ui": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sveltejs/adapter-auto": "catalog:sveltejs",
    "@sveltejs/kit": "catalog:sveltejs",
    "@sveltejs/vite-plugin-svelte": "catalog:sveltejs",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.9.0",
    "prettier-plugin-svelte": "catalog:sveltejs",
    "svelte": "catalog:sveltejs",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-svelte": "3.0.0"
  }
}
