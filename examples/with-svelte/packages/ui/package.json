{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sveltejs/kit": "catalog:sveltejs",
    "@sveltejs/vite-plugin-svelte": "catalog:sveltejs",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.15.0",
    "globals": "17.11.0",
    "playwright": "1.65.1",
    "svelte": "catalog:sveltejs",
    "svelte-check": "catalog:sveltejs",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0"
  }
}
