{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "storybook-static/**"],
      "dependsOn": ["^build"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "check-types": { "dependsOn": ["^build", "^check-types"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "clean": { "cache": false },
    "preview-storybook": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
