{
  "name": "@repo/database",
  "version": "1.0.0",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "build": "tsup src/client.ts --format esm",
    "db:migrate:deploy": "prisma db migrate",
    "db:migrate:dev": "prisma db update",
    "db:push": "prisma db update",
    "db:seed": "tsx src/seed.ts",
    "dev": "tsup src/client.ts --format esm --watch",
    "format": "prisma contract format",
    "generate": "prisma contract emit",
    "lint": "eslint --config .eslintrc.js . --max-warnings 0",
    "prebuild": "pnpm run generate",
    "predev": "pnpm run generate"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "dotenv": "18.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "10.10.0",
    "prisma": "8.0.0-rc.15",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
