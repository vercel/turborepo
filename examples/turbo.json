{
  "extends": ["//"],
  "tasks": {
    // This needs to exist because upstream packages depend on it and
    // it's not defined at the root level.
    "topo": {},
    // We override inputs to avoid a costly globwalk
    "lint:prettier": {
      "inputs": []
    },
    "check-types": {
      "command": null
    },
    "check-examples": {
      "passThroughEnv": ["VERCEL_TOKEN"],
      "command": [
        "pnpm",
        "exec",
        "tsx",
        "--env-file=.env.local",
        "check-examples.ts"
      ]
    },
    "install-all": {
      "cache": false,
      "command": ["pnpm", "exec", "tsx", "install-all.ts"]
    },
    "update-turbo": {
      "cache": false,
      "command": ["pnpm", "exec", "tsx", "update-turbo.ts"]
    }
  }
}
