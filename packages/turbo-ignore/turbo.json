{
  "$schema": "../../docs/public/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "command": ["pnpm", "exec", "tsdown"]
    },
    "test": {
      "command": ["pnpm", "exec", "jest"]
    },
    "check-types": {
      "command": ["pnpm", "exec", "tsc", "--noEmit"]
    },
    "lint:prettier": {
      "command": [
        "pnpm",
        "exec",
        "prettier",
        "-c",
        ".",
        "--cache",
        "--ignore-path=../../.prettierignore"
      ]
    }
  }
}
